---
import "../styles/global.css";
import Navbar from "../components/nav.astro";
import Footer from "../components/footer.astro"; /* NTS: component imports MUST be capital */

interface Props {
    title: string;
    description?: string;
}

const {
    title,
    description = "personal portfolio and blog"
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.ico" />
</head>

<body class="layout-wrapper">

    <Navbar/>
    
    <div class="content">
        <slot />
    </div>

    <Footer/>

    <script is:inline src="/src/scripts/title.js"></script>
</body>
</html>

<style>

  .layout-wrapper {
    display: flex;
    flex-direction: column;
    min-height: 100vh;
  }

  .content {
    flex: 1; /* same as display: flex anyway */
  }

</style>