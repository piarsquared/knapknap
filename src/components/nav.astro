---
const navItems = [
  { name: "Home", href: "/" },
  { name: "Projects", href: "/projects" },
  { name: "Blog", href: "/blog" },
  { name: "About", href: "/about" },
];
---

<header class="navbar">
  <div class="nav-container">
    <a href="/"><img src="../favicon.png" alt="piar" class="logoimg"></a>
    <nav>
      <ul class="nav-links">
        {navItems.map((item) => (
          <li>
            <a href={item.href}>{item.name}</a>
          </li>
        ))}
      </ul>
    </nav>
  </div>
</header>

<!-- Just going to use internal CSS -->

<style> 

*,
*::before,
*::after {
  box-sizing: border-box;
} /* this really goofy line targets all things to not add to the padding, makes sure the bar is actually consistent */

  .navbar {
    width: 100%;
    border-bottom: 2px solid var(--ctp-surface0);
    background: var(--ctp-mantle);
  }

  .nav-container {
    width: 100%;
    height: 60px;
    padding: 0 6rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo {
    font-weight: 700;
    font-size: 1.2rem;
    color: var(--ctp-text);
    text-decoration: none;
  }

  .dot {
    color: var(--ctp-mauve);
  }

  .nav-links {
    display: flex;
    gap: 1.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-links a {
    color: var(--ctp-subtext);
    text-decoration: none;
    font-size: 0.95rem;
    transition: color 0.2s ease;
  }

  .nav-links a:hover {
    color: var(--ctp-mauve);
  }

  .logoimg:hover{

    transform: scale(1.4) rotate(10deg);

    transition: 0.5s ease;

  }

  .logoimg{

    transition: 0.5s ease;

  }

</style>