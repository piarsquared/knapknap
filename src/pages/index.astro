---
import Layout from "../layouts/layout.astro";

import { getCollection } from 'astro:content'; // from documentation: getCollection() fetches an entire collection and returns an array of entries

const allPosts = await getCollection('posts');

const sortedPosts = allPosts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

// const latestPost = sortedPosts[0];
const latestPost = sortedPosts.slice(0, 3); // i wanna display 3 most recent instead

---

<Layout title="home" description="Personal portfolio and blog">

  <navbar/>

  <main class="container">

    <section class="hero">
      <h1>hi, i'm <span class="highlight">piar</span></h1>

      <p class="bio">
        software • systems • linux • wii
      </p>
    </section>

    <section class="now">
      <h2>what i'm up to</h2>

      <ul>
        <li>c++, python software developer</li>
        <li>systems programming</li>
        <li>linux/wii tinkerer</li>
        <li>youtuber</li>
      </ul>
    </section>

    <section class="recent-posts">
      <h2>recent posts</h2>
      <ul>
        {latestPost.map((post) => (
        <li class="post-preview">
          <a href={`/blog/${post.id}`}>{post.data.title}</a>

            <span class="post-date">
            - {post.data.date.toLocaleDateString("en-US", {
              year: "numeric",
              month: "short",
              day: "numeric",
              timeZone: "UTC"
            })}
          </span>

        </li>
      ))}
      </ul>
    </section>

    <section class="contact-cta">
      <h2>contact me</h2>

      <p>if you need to reach out you can do so through:</p>

      <ul>
        <li>
          <a href="mailto:contact.piarsquared@gmail.com">
            contact.piarsquared@gmail.com
          </a>
        </li>
        <li>
          <a href="https://discord.gg/XghpxaUDWZ" target="_blank" rel="noopener noreferrer">
            discord server
          </a>
        </li>
        <li>          
          <a href="https://youtube.com/@piartech" target="_blank" rel="noopener noreferrer">
            youtube
          </a></li>
      </ul>
    </section>

    <style>

    ul {
    list-style: none;
    padding: 0;
  }

  li {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  }
    
</style>

  </main>

</Layout>