---
import Layout from "../layouts/layout.astro";

import { getCollection } from 'astro:content'; // from documentation: getCollection() fetches an entire collection and returns an array of entries

const allPosts = await getCollection('posts');

const sortedPosts = allPosts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

// const latestPost = sortedPosts[0];
const latestPost = sortedPosts.slice(0, 3); // i wanna display 3 most recent instead

---

<Layout title="home" description="Personal portfolio and blog">

  <main class="container">

    <section class="hero">
      <h1>hi, i'm <span class="highlight">piar</span></h1>

      <p class="bio">
        software • systems • linux • wii
      </p>
    </section>

    <div class="content-box">

    <section class="section-block now-section">
      <h2>what i'm up to</h2>

      <br>

      <div class="now-grid">
        <div class="now-card">
          <h3>development</h3>
          <div class="push-over"><p>writing c++ & python for systems and software</p></div>
        </div>

        <br>

        <div class="now-card">
          <h3>tinkering</h3>
          <div class="push-over"><p>customizing linux environments and working with wii homebrew development</p></div>
        </div>

        <br>

        <div class="now-card">
          <h3>content</h3>
          <div class="push-over"><p>creating youtube videos about software and tech</p></div>
        </div>
      </div>

    </section>

    </div>

    <div class="content-box">

    <section class="recent-posts">
      <h2>recent posts</h2>

      <div class="push-over"><a href="/blog" class="view-all">view all posts →</a></div>

      <ul>
        {latestPost.map((post) => (
        <li class="post-preview">
          <a href={`/blog/${post.id}`}>{post.data.title}</a>

            <span class="post-date">
            - {post.data.date.toLocaleDateString("en-US", {
              year: "numeric",
              month: "short",
              day: "numeric",
              timeZone: "UTC"
            })}
          </span>

        </li>
      ))}
      </ul>
    </section>

    </div>

    <div class="content-box">

    <section class="contact-cta">
      <h2>contact me</h2>

      <p>if you need to reach out you can do so through:</p>

      <ul>
        <li>
          <a href="mailto:contact.piarsquared@gmail.com">
            contact.piarsquared@gmail.com
          </a>
        </li>
        <li>
          <a href="https://discord.gg/XghpxaUDWZ" target="_blank" rel="noopener noreferrer">
            discord server
          </a>
        </li>
        <li>          
          <a href="https://youtube.com/@piartech" target="_blank" rel="noopener noreferrer">
            youtube
          </a></li>
      </ul>
    </section>

    </div>

    <style>

  .recent-posts li {
    display: flex;
    align-items: center;
    gap: 0.3rem;
  } /* fixed some minor scope issues here. */

  .content-box {
    
    background-color: var(--ctp-mantle);
    border: 1px solid var(--ctp-flamingo);
    border-radius: 20px;
    padding: 2rem;
    margin-top: 3rem;

  }

  .push-over /* amazing naming scheme */{

    margin-left: 2rem;

  }

</style>

  </main>

</Layout>